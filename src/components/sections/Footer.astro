---
import Icon from "../shared/Icon.astro";
import { CONTACT_EMAIL, TIKTOK_URL, whatsappUrl } from "../../lib/contact";
import { getNavTabs } from "../../lib/navSettings";

const currentYear = new Date().getFullYear();
const navTabs = await getNavTabs();

const footerLinks = [
  { name: "GitHub", href: "https://github.com/AronJustoC", icon: "github" },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/aronjusto/",
    icon: "linkedin",
  },
  { name: "TikTok", href: TIKTOK_URL, icon: "tiktok" },
  { name: "WhatsApp", href: whatsappUrl(), icon: "whatsapp" },
  { name: "Email", href: `mailto:${CONTACT_EMAIL}`, icon: "email" },
];

const sections = [
  {
    title: "Navegación",
    links: [
      { name: "Inicio", href: "/" },
      { name: "Proyectos", href: "/proyectos" },
      { name: "Tienda", href: "/tienda" },
      { name: "Blog", href: "/blog" },
      { name: "Cursos", href: "/cursos" },
    ],
  },
  {
    title: "Contacto",
    links: [
      { name: "WhatsApp", href: whatsappUrl() },
      { name: "Email", href: `mailto:${CONTACT_EMAIL}` },
      { name: "GitHub", href: "https://github.com/AronJustoC" },
    ],
  },
].map((section) => ({
  ...section,
  links: section.links.filter((link) => {
    const tabKeys: Record<string, keyof typeof navTabs> = {
      "/proyectos": "proyectos",
      "/tienda": "tienda",
      "/blog": "blog",
      "/cursos": "cursos",
    };
    const key = tabKeys[link.href];
    return key ? navTabs[key] : true;
  }),
}));
---

<footer class="hairline-t bg-[var(--color-bg)] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <!--Grid principal-->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!--Primera columna - Marca-->
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-3">
          <img
            src="/brand/icono_cuadrado.svg"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 transition-transform duration-200 hover:-translate-y-px"
          />
          <span class="display text-xl text-[var(--color-text)]">
            Aron <span class="text-[var(--color-action)]">J.</span>
          </span>
        </a>
        <p class="text-sm text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
          Soluciones de software a medida para empresas y negocios.
        </p>
      </div>
      <!--Col. Links -->
      <div class="grid grid-cols-2 gap-8 md:col-span-2">
        {
          sections.map((section) => (
            <div>
              <p class="label text-[color-mix(in_srgb,var(--color-text)_75%,transparent)] mb-4">{section.title}</p>
              <ul class="space-y-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="footer-link text-sm"
                    >
                      {link.name}{link.href.startsWith("http") &&  <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!--Separador y bottom row-->
    <div class="hairline-t pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="label text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
        Hecho en Cusco, Perú · © {currentYear}
      </p>
      <div class="flex items-center gap-3">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="w-9 h-9 flex items-center justify-center transition-colors duration-200 text-[color-mix(in_srgb,var(--color-text)_68%,transparent)] hover:text-[var(--focus-color)]"
              aria-label={link.name}
            >
              <Icon icon={link.icon} class="w-4 h-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    color: var(--color-text);
    transition: color 200ms ease-out;
  }
  .footer-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--focus-color);
  }
  .footer-link:hover::after,
  .footer-link:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-link::after {
      transition: none;
    }
  }
</style>
