---
import Icon from "../shared/Icon.astro";
import { CONTACT_EMAIL, whatsappUrl } from "../../lib/contact";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { name: "GitHub", href: "https://github.com/AronJustoC", icon: "github" },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/aronjusto/",
    icon: "linkedin",
  },
  { name: "WhatsApp", href: whatsappUrl(), icon: "whatsapp" },
  { name: "Email", href: `mailto:${CONTACT_EMAIL}`, icon: "email" },
];

const sections = [
  {
    title: "Navegación",
    links: [
      { name: "Inicio", href: "/" },
      { name: "Proyectos", href: "/proyectos" },
      { name: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Contacto",
    links: [
      { name: "WhatsApp", href: whatsappUrl() },
      { name: "Email", href: `mailto:${CONTACT_EMAIL}` },
      { name: "GitHub", href: "https://github.com/AronJustoC" },
    ],
  },
];
---

<footer class="hairline-t bg-[var(--color-bg)] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <!--Grid principal-->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!--Primera columna - Marca-->
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-3">
          <img
            src="/brand/icono_cuadrado.svg"
            alt=""
            width="40"
            height="40"
            class="w-10 h-10 transition-transform duration-200 hover:-translate-y-px"
          />
          <span class="display text-xl text-[var(--color-text)]">
            Aron <span class="text-[var(--color-action)]">Choque</span>
          </span>
        </a>
        <p class="text-sm text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
          Soluciones de software a medida para empresas y negocios.
        </p>
      </div>
      <!--Col. Links -->
      <div class="grid grid-cols-2 gap-8 md:col-span-2">
        {
          sections.map((section) => (
            <div>
              <p class="label text-[color-mix(in_srgb,var(--color-text)_75%,transparent)] mb-4">{section.title}</p>
              <ul class="space-y-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="link-arrow text-sm"
                    >
                      {link.name}{link.href.startsWith("http") &&  <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!--Separador y bottom row-->
    <div class="hairline-t pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="label text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
        Hecho en Cusco, Perú · © {currentYear}
      </p>
      <div class="flex items-center gap-3">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 flex items-center justify-center transition-colors duration-200 text-[color-mix(in_srgb,var(--color-text)_68%,transparent)] hover:text-[var(--focus-color)]"
              aria-label={link.name}
            >
              <Icon icon={link.icon} class="w-4 h-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
