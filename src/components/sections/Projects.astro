---
import type { Project } from "../../types";
import ProjectCard from "../shared/ProjectCard.astro";

const response = await fetch(`${import.meta.env.API_BASE_URL}/projects`);
const responseData = await response.json();
const projects: Project[] = responseData.projects;
console.log("datos recibidos de la api: ", projects);
---

<section class="py-16">
  <div class="container max-w-6xl m-auto p-6">
    <h2 class="text-3xl font-bold text-center mb-8">Mis Proyectos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
