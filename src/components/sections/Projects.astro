---
import type { Project } from "../../types";
import { featuredProjects } from "../../data/projects";
import ProjectRow from "../shared/ProjectRow.astro";

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let projects: Project[] = [];
try {
  const response = await fetch(`${apiBaseUrl}/projects/public`, {
    signal: AbortSignal.timeout(5000),
  });
  if (response.ok) projects = (await response.json()).projects ?? [];
} catch (error) {
  console.error("No se pudo cargar projects:", error);
}
// Respaldo: si el backend falla o no tiene proyectos, se muestran los destacados.
// La API manda; los destacados que aún no están en la base se añaden por título.
const list: Project[] = [
  ...projects,
  ...featuredProjects.filter((f) => !projects.some((p) => p.title === f.title)),
];
---

<section id="proyectos" class="py-16 lg:py-20 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="display text-[clamp(2.25rem,5vw,3.5rem)] text-[var(--color-text)]">
        Proyectos
      </h2>
      {
        <span class="label text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
            {list.length} registros
          </span>
      }
    </div>

    <div class="hairline-t">
      <ul>
        {list.map((project, i) => <ProjectRow project={project} eager={i < 3} />)}
      </ul>
    </div>

    <div class="mt-8">
      <a href="/proyectos" class="link-arrow text-sm">
        Ver todos los proyectos <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </div>
  </div>
</section>

