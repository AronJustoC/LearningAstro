---
import ProjectCard from "../shared/ProjectCard.astro";
---

<section class="py-16">
  <div class="container mx-auto max-w-6xl">
    <h2 class="text-3xl font-bold text-center mb-8">Mis Proyectos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Ejemplo de Proyecto 1 -->
      <ProjectCard
        project={{
          id: 1,
          title: "Mi proyecto",
          imageUrl:
            "https://cdn.pixabay.com/photo/2025/05/26/00/39/australian-pelican-9622118_960_720.jpg",
          description: "Descripción breve del proyecto.",
          repoUrl: "https://github.com/usuario/proyecto",
        }}
      />

      <!-- Ejemplo de Proyecto 2 -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-bold mb-2">Proyecto Dos</h3>
        <p class="text-gray-700 mb-4">
          Otra descripción para un proyecto diferente, destacando sus
          características principales.
        </p>
        <a href="#" class="text-blue-500 hover:underline">Ver más</a>
      </div>
      <!-- Ejemplo de Proyecto 3 -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-bold mb-2">Proyecto Tres</h3>
        <p class="text-gray-700 mb-4">
          Descripción del tercer proyecto. Ideal para mostrar la variedad de tu
          trabajo.
        </p>
        <a href="#" class="text-blue-500 hover:underline">Ver más</a>
      </div>
    </div>
  </div>
</section>
