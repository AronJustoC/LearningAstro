---
import IconCarousel from "../shared/IconCarousel.astro";

// TechCarousel.astro
const technologies = [
  { name: "Node.js", icon: "nodejs" },
  { name: "TypeScript", icon: "typescript" },
  { name: "Express", icon: "express" },
  { name: "PostgreSQL", icon: "postgresql" },
  { name: "MongoDB", icon: "mongodb" },
  { name: "Docker", icon: "docker" },
  { name: "Prisma", icon: "prisma" },
  { name: "GraphQL", icon: "graphql" },
];

// Duplicar el array para loop infinito suave
const duplicatedTech = [...technologies, ...technologies, ...technologies];
---

<section
  class="relative py-16 overflow-hidden transition-colors duration-300"
  style="background-color: var(--color-bg);"
>
  <!-- Título -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-10 text-center">
    <h2
      class="text-2xl lg:text-3xl font-bold"
      style="color: var(--color-text);"
    >
      Stack Backend
    </h2>
  </div>

  <!-- Carrusel infinito -->
  <div class="relative">
    <!-- Gradientes laterales para efecto fade -->
    <div
      class="absolute left-0 top-0 bottom-0 w-1/3 z-10 pointer-events-none"
      style="background: linear-gradient(90deg, var(--color-bg) 0%, transparent 100%);"
    >
    </div>
    <div
      class="absolute right-0 top-0 bottom-0 w-1/3 z-10 pointer-events-none"
      style="background: linear-gradient(-90deg, var(--color-bg) 0%, transparent 100%);"
    >
    </div>

    <!-- Contenedor del carrusel -->
    <div class="tech-carousel whitespace-nowrap w-4xl">
      {
        duplicatedTech.map((tech) => (
          <div
            class="tech-card inline-flex items-center gap-3 px-6 py-6 rounded-xl border transition-all duration-300 hover:scale-105 mr-6 shadow-xl"
            style="background-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-primary) 5%); border-color: color-mix(in srgb, var(--color-primary) 20%, transparent);"
          >
            <IconCarousel icon={tech.icon} class="w-10 h-10" />
            <span
              class="text-md font-medium whitespace-nowrap"
              style="color: var(--color-text);"
            >
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-carousel {
    animation: scroll 25s linear infinite;
    will-change: transform;
  }

  .tech-carousel:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .tech-card:hover {
    background-color: color-mix(
      in srgb,
      var(--color-bg) 90%,
      var(--color-primary) 10%
    ) !important;
    border-color: color-mix(
      in srgb,
      var(--color-primary) 40%,
      transparent
    ) !important;
  }
</style>
