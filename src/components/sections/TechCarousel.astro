---
import IconCarousel from "../shared/IconCarousel.astro";

// Cada item usa `icon` (logo real, ver IconCarousel.astro) o `badge`
// (iniciales, para herramientas sin logo embebido todavía).
const categories = [
  {
    title: "Backend & Datos",
    items: [
      { name: "Node.js", icon: "nodejs" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Express", icon: "express" },
      { name: "NestJS", icon: "nestjs" },
      { name: "PostgreSQL", icon: "postgresql" },
      { name: "MySQL", icon: "mysql" },
      { name: "MongoDB", icon: "mongodb" },
      { name: "Prisma", icon: "prisma" },
      { name: "Redis", icon: "redis" },
    ],
  },
  {
    title: "Frontend",
    items: [
      { name: "Astro", icon: "astro" },
      { name: "React", icon: "react" },
      { name: "Next.js", icon: "nextdotjs" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Tailwind CSS", icon: "tailwindcss" },
      { name: "shadcn/ui", icon: "shadcnui" },
      { name: "Ant Design", icon: "antdesign" },
    ],
  },
  {
    title: "GIS & Datos Espaciales",
    items: [
      { name: "QGIS", icon: "qgis" },
      { name: "Leaflet", icon: "leaflet" },
      { name: "DBeaver", icon: "dbeaver" },
    ],
  },
  {
    title: "DevOps & Infra",
    items: [
      { name: "Docker", icon: "docker" },
      { name: "GitHub Actions", icon: "githubactions" },
      { name: "GraphQL", icon: "graphql" },
      { name: "Swagger / OpenAPI", icon: "swagger" },
    ],
  },
  {
    title: "IA & Automatización",
    items: [
      { name: "Claude Code", icon: "claude" },
      { name: "Codex", icon: "openai" },
    ],
  },
];
const total = categories.reduce((n, c) => n + c.items.length, 0);
---

<section id="stack" class="py-20 lg:py-28 scroll-mt-24" aria-labelledby="stack-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="home-section-head">
      <div>
        <span class="label home-muted block mb-3">02 · Herramientas</span>
        <h2 id="stack-title" class="display text-[clamp(2.25rem,5vw,3.5rem)]">Stack</h2>
      </div>
      <span class="label home-muted">{total} registros</span>
    </div>

    <div class="hairline-t">
      {
        categories.map((category) => (
          <div class="motion-reveal-row hairline-b py-6 grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-3 md:gap-8 md:items-baseline">
            <span class="label home-muted">{category.title}</span>
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-3 list-none m-0 p-0">
              {category.items.map((tech) => (
                <li class="stack-tag inline-flex items-center gap-2 text-sm">
                  {tech.icon && <IconCarousel icon={tech.icon} class="w-4 h-4 shrink-0" />}
                  <span class="whitespace-nowrap">{tech.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
