---
import IconCarousel from "../shared/IconCarousel.astro";

// Cada item usa `icon` (logo real, ver IconCarousel.astro) o `badge`
// (iniciales, para herramientas sin logo embebido todavía).
const categories = [
  {
    title: "Backend & Datos",
    items: [
      { name: "Node.js", icon: "nodejs" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Express", icon: "express" },
      { name: "NestJS", icon: "nestjs" },
      { name: "PostgreSQL", icon: "postgresql" },
      { name: "MySQL", icon: "mysql" },
      { name: "MongoDB", icon: "mongodb" },
      { name: "Prisma", icon: "prisma" },
      { name: "Redis", icon: "redis" },
    ],
  },
  {
    title: "Frontend",
    items: [
      { name: "Astro", icon: "astro" },
      { name: "React", icon: "react" },
      { name: "Next.js", icon: "nextdotjs" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Tailwind CSS", icon: "tailwindcss" },
      { name: "shadcn/ui", icon: "shadcnui" },
      { name: "Ant Design", icon: "antdesign" },
    ],
  },
  {
    title: "GIS & Datos Espaciales",
    items: [
      { name: "QGIS", icon: "qgis" },
      { name: "Leaflet", icon: "leaflet" },
      { name: "DBeaver", icon: "dbeaver" },
    ],
  },
  {
    title: "DevOps & Infra",
    items: [
      { name: "Docker", icon: "docker" },
      { name: "GitHub Actions", icon: "githubactions" },
      { name: "GraphQL", icon: "graphql" },
      { name: "Swagger / OpenAPI", icon: "swagger" },
    ],
  },
  {
    title: "IA & Automatización",
    items: [
      { name: "Claude Code", icon: "claude" },
      { name: "Codex", icon: "openai" },
    ],
  },
];
---

<section
  class="py-16 transition-colors duration-300"
  style="background-color: var(--color-bg);"
>
  <div class="container max-w-6xl m-auto p-6">
    <h2
      class="text-2xl lg:text-3xl font-bold text-center mb-10"
      style="color: var(--color-text);"
    >
      Stack & Herramientas
    </h2>
    <div class="space-y-8">
      {
        categories.map((category) => (
          <div>
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-center mb-3 opacity-50"
              style="color: var(--color-text);"
            >
              {category.title}
            </h3>
            <div class="flex flex-wrap justify-center gap-2">
              {category.items.map((tech) => (
                <div
                  class="tech-card inline-flex items-center gap-2 px-3 py-2 rounded-lg border transition-colors duration-300"
                  style="background-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-primary) 5%); border-color: color-mix(in srgb, var(--color-primary) 15%, transparent);"
                >
                  {tech.icon && (
                    <IconCarousel icon={tech.icon} class="w-5 h-5" />
                  )}
                  <span
                    class="text-xs font-medium whitespace-nowrap"
                    style="color: var(--color-text);"
                  >
                    {tech.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-card:hover {
    background-color: color-mix(
      in srgb,
      var(--color-bg) 90%,
      var(--color-primary) 10%
    ) !important;
    border-color: color-mix(
      in srgb,
      var(--color-primary) 40%,
      transparent
    ) !important;
  }
</style>
