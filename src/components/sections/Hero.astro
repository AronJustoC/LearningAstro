---
import "@fontsource/jost/500.css";
import "@fontsource/jost/700.css";
import { CONTACT_EMAIL, whatsappUrl } from "../../lib/contact";
import { featuredProjects } from "../../data/projects";
import Icon from "../shared/Icon.astro";
import AccentPicker from "./AccentPicker";

// Abanico: tres proyectos reales (centro = el primero destacado).
const [a, b, c] = featuredProjects;
const cards = [
  { ...b, x: "-62%", r: "-7deg", z: 1 },
  { ...a, x: "0%", r: "0deg", z: 3 },
  { ...c, x: "62%", r: "7deg", z: 2 },
];

const stack = [
  "Astro", "React", "Tailwind CSS", "Node.js", "NestJS", "Prisma",
  "PostgreSQL", "Docker", "GitHub Actions", "Claude Code", "MCP",
];
---

<section aria-labelledby="hero-title" data-hero-motion class="hero-wrap hairline-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 lg:pt-10 lg:pb-16 text-center">
    <p class="hero-rise hero-loc m-0">Cusco, Perú</p>
    <a href={`mailto:${CONTACT_EMAIL}`} class="hero-rise hero-mail">{CONTACT_EMAIL}</a>

    <h1 id="hero-title" class="hero-rise hero-name">Aron J. Choque</h1>

    <div class="hero-rise hero-fan" data-hero-fan aria-hidden="true" style="animation-delay: 80ms;">
      {cards.map((card) => (
        <a
          href={`/proyectos/${card.slug}`}
          tabindex="-1"
          class="hero-card"
          style={`--x:${card.x}; --r:${card.r}; z-index:${card.z};`}
        >
          <img src={card.imageUrl} alt="" width="200" height="250" loading="eager" decoding="async" />
        </a>
      ))}
    </div>

    <p class="hero-rise hero-tag m-0" style="animation-delay: 160ms;">
      Software a medida<br />para empresas.
    </p>

    <div class="hero-rise hero-actions" style="animation-delay: 220ms;">
      <a href="/contacto" class="btn-block">
        Hablemos de tu proyecto
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
      <a href="/#proyectos" class="hero-quiet">Proyectos</a>
      <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="hero-quiet">
        <Icon icon="whatsapp" class="w-3.5 h-3.5" aria-hidden="true" />
        WhatsApp
        <span class="sr-only">(se abre en otra pestaña)</span>
      </a>
    </div>

    <p class="hero-rise hero-clients-label label m-0" style="animation-delay: 280ms;">Stack habitual</p>
    <p class="hero-rise hero-clients m-0" style="animation-delay: 280ms;">{stack.join(" · ")}</p>
  </div>

  <AccentPicker client:idle />
</section>

<style>
  .hero-wrap { overflow-x: clip; --font-hero: "Jost", "Futura", "Barlow Condensed", sans-serif; }

  .hero-loc {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-mail {
    display: inline-block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .hero-mail:hover { color: var(--color-text); }

  .hero-name {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(1.9rem, 7.6vw, 6.3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-transform: uppercase;
    margin: 1.25rem 0 0;
  }

  /* Abanico: 3 tarjetas redondeadas, superpuestas y giradas; el puntero las inclina (--mx/--my en [-1,1]). */
  .hero-fan {
    --mx: 0; --my: 0;
    position: relative;
    height: clamp(10rem, 21vw, 15rem);
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
  }
  .hero-card {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(7rem, 16vw, 12rem);
    aspect-ratio: 4 / 5;
    margin-left: calc(clamp(7rem, 16vw, 12rem) / -2);
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: 0 2px 6px rgb(15 23 42 / 0.08), 0 18px 40px -12px rgb(15 23 42 / 0.3);
    transform:
      translate(calc(var(--x) + var(--mx) * 10px), calc(var(--my) * 8px))
      rotate(calc(var(--r) + var(--mx) * 3deg));
    transition: transform 0.6s var(--ease-out-expo);
  }
  html.dark .hero-card { box-shadow: 0 2px 6px rgb(0 0 0 / 0.5), 0 18px 40px -12px rgb(0 0 0 / 0.7); }
  .hero-card img { width: 100%; height: 100%; object-fit: cover; object-position: left top; display: block; }

  .hero-tag {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(1.6rem, 6.2vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 22%, transparent);
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .hero-quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    transition: color 0.15s ease;
  }
  .hero-quiet:hover { color: var(--color-text); }

  .hero-clients-label { margin-top: 3rem; color: var(--color-text); }
  .hero-clients {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
</style>

<script>
  // Inclinación amortiguada con el puntero. Nada si el usuario prefiere menos movimiento.
  const fan = document.querySelector<HTMLElement>("[data-hero-fan]");
  const section = fan?.closest("section");
  if (fan && section && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const tick = () => {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      fan.style.setProperty("--mx", cx.toFixed(3));
      fan.style.setProperty("--my", cy.toFixed(3));
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(tick) : 0;
    };
    const aim = (x: number, y: number) => {
      tx = x; ty = y;
      if (!raf) raf = requestAnimationFrame(tick);
    };
    section.addEventListener("pointermove", (e) => {
      const r = section.getBoundingClientRect();
      aim(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
    });
    section.addEventListener("pointerleave", () => aim(0, 0));
  }
</script>
