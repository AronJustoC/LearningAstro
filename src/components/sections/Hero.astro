---
import "@fontsource/jost/500.css";
import "@fontsource/jost/700.css";
import { whatsappUrl } from "../../lib/contact";
import { featuredProjects } from "../../data/projects";
import Icon from "../shared/Icon.astro";
import AccentPicker from "./AccentPicker";

// Abanico: hasta 3 proyectos de la portada (API); si falla, los 3 primeros destacados.
const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
type Card = { title: string; imageUrl?: string | null; slug?: string };
let fan: Card[] = [];
try {
  const response = await fetch(`${apiBaseUrl}/projects/portada`, { signal: AbortSignal.timeout(5000) });
  if (response.ok) {
    const list = (await response.json()).projects;
    if (Array.isArray(list)) {
      fan = list.slice(0, 3).map((p: Card) => ({
        ...p,
        slug: featuredProjects.find((f) => f.title === p.title)?.slug,
      }));
    }
  }
} catch (error) {
  console.error("No se pudo cargar la portada:", error);
}
if (fan.length === 0) fan = featuredProjects.slice(0, 3);
// Orden visual: izquierda, centro (primero), derecha.
const [a, b, c] = fan;
const slots = [
  { ...b, x: "-62%", r: "-7deg", z: 1 },
  { ...a, x: "0%", r: "0deg", z: 3 },
  { ...c, x: "62%", r: "7deg", z: 2 },
];
const cards = slots.filter((s) => s.title).map((s, i) => ({
  ...s,
  img: s.imageUrl || featuredProjects[i % featuredProjects.length].imageUrl,
}));

const stack = [
  "Astro", "React", "Tailwind CSS", "Node.js", "NestJS", "Prisma",
  "PostgreSQL", "Docker", "GitHub Actions", "Claude Code", "MCP",
];
---

<section aria-labelledby="hero-title" data-hero-motion class="hero-wrap hairline-b">
  <div class="hero-inner max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 text-center">
    <h1 id="hero-title" class="sr-only">Aron J.</h1>

    <div class="hero-rise hero-fan" data-hero-fan aria-hidden="true" style="animation-delay: 80ms;">
      {cards.map((card) => (
        <Fragment>
          {card.slug ? (
            <a href={`/proyectos/${card.slug}`} tabindex="-1" class="hero-card" style={`--x:${card.x}; --r:${card.r}; z-index:${card.z};`}>
              <img src={card.img} alt="" width="380" height="238" loading="eager" decoding="async" />
            </a>
          ) : (
            <div class="hero-card" style={`--x:${card.x}; --r:${card.r}; z-index:${card.z};`}>
              <img src={card.img} alt="" width="380" height="238" loading="eager" decoding="async" />
            </div>
          )}
        </Fragment>
      ))}
    </div>

    <p class="hero-rise hero-tag m-0" style="animation-delay: 160ms;">
      Software a medida<br />para empresas.
    </p>

    <div class="hero-rise hero-actions" style="animation-delay: 220ms;">
      <a href="/contacto" class="btn-block">
        Hablemos de tu proyecto
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
      <a href="/#proyectos" class="hero-quiet">Proyectos</a>
      <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="hero-quiet">
        <Icon icon="whatsapp" class="w-3.5 h-3.5" aria-hidden="true" />
        WhatsApp
        <span class="sr-only">(se abre en otra pestaña)</span>
      </a>
    </div>

    <div class="hero-rise hero-stack" style="animation-delay: 280ms;">
      <p class="hero-clients-label label m-0">Stack habitual</p>
      <p class="hero-clients m-0">{stack.join(" · ")}</p>
    </div>
  </div>

  <AccentPicker client:idle />
</section>

<style>
  .hero-wrap {
    overflow-x: clip; --font-hero: "Jost", sans-serif;
    display: flex; flex-direction: column; justify-content: center;
    min-height: calc(100vh - 4rem);
    min-height: calc(100svh - 4rem);
  }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: clamp(1.5rem, 3.5vh, 2.75rem); }

  .hero-loc {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-mail {
    display: inline-block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .hero-mail:hover { color: var(--color-text); }

  .hero-name {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(1.9rem, 7.6vw, 6.3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-transform: uppercase;
    margin: 1.25rem 0 0;
  }

  /* Abanico: 3 tarjetas redondeadas, superpuestas y giradas; el puntero las inclina (--mx/--my en [-1,1]). */
  .hero-fan {
    --mx: 0; --my: 0;
    position: relative;
    --w: 300px; --k: 0.8;
    width: 100%;
    height: calc(var(--w) * 0.625 + 8px);
    margin: 0;
  }
  .hero-card {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--w);
    aspect-ratio: 16 / 10;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 6px rgb(15 23 42 / 0.08), 0 18px 40px -12px rgb(15 23 42 / 0.3);
    transform:
      translate(calc(-50% + var(--x) * var(--k) + var(--mx) * 10px), calc(var(--my) * 8px))
      rotate(calc(var(--r) + var(--mx) * 3deg));
    transition: transform 0.6s var(--ease-out-expo);
  }
  html.dark .hero-card { background: #12161c; box-shadow: 0 2px 6px rgb(0 0 0 / 0.5), 0 18px 40px -12px rgb(0 0 0 / 0.7); }
  .hero-card img { width: 100%; height: 100%; object-fit: contain; object-position: center top; display: block; }

  @media (min-width: 1024px) { .hero-fan { --w: 380px; --k: 1; } }
  @media (max-width: 639px) { .hero-fan { --w: min(70vw, 260px); --k: 0.12; } }

  .hero-tag {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 22%, transparent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  @media (max-width: 639px) {
    .hero-actions { width: 100%; }
    .hero-actions :global(.btn-block) { flex: 1 1 100%; justify-content: center; }
  }
  .hero-quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    transition: color 0.15s ease;
  }
  .hero-quiet:hover { color: var(--color-text); }

  .hero-stack { display: flex; flex-direction: column; gap: 0.5rem; }
  .hero-clients-label { color: var(--color-text); }
  .hero-clients {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
</style>

<script>
  // Inclinación amortiguada con el puntero. Nada si el usuario prefiere menos movimiento.
  const fan = document.querySelector<HTMLElement>("[data-hero-fan]");
  const section = fan?.closest("section");
  if (fan && section && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const tick = () => {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      fan.style.setProperty("--mx", cx.toFixed(3));
      fan.style.setProperty("--my", cy.toFixed(3));
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(tick) : 0;
    };
    const aim = (x: number, y: number) => {
      tx = x; ty = y;
      if (!raf) raf = requestAnimationFrame(tick);
    };
    section.addEventListener("pointermove", (e) => {
      const r = section.getBoundingClientRect();
      aim(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
    });
    section.addEventListener("pointerleave", () => aim(0, 0));
  }
</script>
