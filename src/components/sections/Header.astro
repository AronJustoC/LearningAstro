---
const links = [
  { name: "Inicio", href: "/" },
  { name: "Proyectos", href: "/proyectos" },
  { name: "Blog", href: "/blog" },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header
  class="sticky top-0 z-50 backdrop-blur-xl hairline-b"
  style="background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);"
>
  <nav class="max-w-7xl mx-auto px-6 lg:px-8" aria-label="Principal">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Aron J. Choque, inicio">
        <img
          src="/brand/icono_cuadrado.svg"
          alt=""
          width="32"
          height="32"
          class="w-8 h-8 transition-transform duration-200 group-hover:scale-105"
        />
        <span class="display text-2xl tracking-wide" style="font-weight: 700;">
          Aron J. <span style="color: var(--focus-color);">Choque</span>
        </span>
      </a>

      <!-- Navegación desktop -->
      <ul class="hidden lg:flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="nav-link inline-flex items-center h-10 px-4 transition-colors duration-200"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Desktop: tema + CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <button
          id="themeToggle"
          class="icon-btn"
          aria-label="Modo oscuro"
          aria-pressed="false"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
        <a href="/contacto" class="btn-block">
          Contactar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
      </div>

      <!-- Móvil: tema + menú -->
      <div class="flex lg:hidden items-center gap-2">
        <button
          id="themeToggleMobile"
          class="icon-btn"
          aria-label="Modo oscuro"
          aria-pressed="false"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
        <button
          id="menuBtn"
          class="icon-btn"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobileMenu"
        >
          <svg class="w-5 h-5" id="menuIcon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg class="w-5 h-5 hidden" id="closeIcon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>

    <!-- Menú móvil -->
    <div id="mobileMenu" class="hidden lg:hidden pb-6">
      <div class="flex flex-col pt-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class="mobile-link hairline-b flex items-center justify-between min-h-12 px-1"
            >
              {link.name}
              <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
          ))
        }
        <a href="/contacto" class="btn-block mt-5">Contactar</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-link,
  .mobile-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nav-link {
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text);
  }
  .nav-link[aria-current="page"] {
    border-bottom-color: var(--color-action);
  }
  .mobile-link:hover {
    color: var(--focus-color);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    color: var(--color-text);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .icon-btn:hover {
    border-color: var(--focus-color);
    background-color: color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .icon-btn:active {
    transform: translateY(1px);
  }
</style>

<script>
  // Menú móvil
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  const menuIcon = document.getElementById("menuIcon");
  const closeIcon = document.getElementById("closeIcon");

  menuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    menuIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
    menuBtn.setAttribute("aria-expanded", String(isOpen));
    menuBtn.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileMenu && !mobileMenu.classList.contains("hidden")) {
      menuBtn?.click();
      (menuBtn as HTMLElement | null)?.focus();
    }
  });

  // Tema
  const themeToggle = document.getElementById("themeToggle");
  const themeToggleMobile = document.getElementById("themeToggleMobile");
  const htmlElement = document.documentElement;

  function applyTheme(theme: string) {
    const isDark = theme === "dark";
    htmlElement.classList.toggle("dark", isDark);
    localStorage.setItem("theme", theme);
    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggleMobile?.setAttribute("aria-pressed", String(isDark));
  }
  const toggle = () =>
    applyTheme(htmlElement.classList.contains("dark") ? "light" : "dark");
  themeToggle?.addEventListener("click", toggle);
  themeToggleMobile?.addEventListener("click", toggle);

  // Sincroniza aria-pressed con el tema aplicado antes de hidratar (ver LayoutBase.astro)
  const initialDark = htmlElement.classList.contains("dark");
  themeToggle?.setAttribute("aria-pressed", String(initialDark));
  themeToggleMobile?.setAttribute("aria-pressed", String(initialDark));
</script>
