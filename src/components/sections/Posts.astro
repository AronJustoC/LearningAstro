---
import PostCard from "../shared/PostCard.astro";
import type { Post } from "../../types/Post.ts";

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
const response = await fetch(`${apiBaseUrl}/posts/public`);
const responseData = response.ok ? await response.json() : { posts: [] };
const posts: Post[] = responseData.posts ?? [];
---

<section id="blog" class="py-16 scroll-mt-24">
  <div class="container max-w-6xl m-auto p-6">
    <h2 class="text-3xl font-bold text-center mb-8">Mis Posts</h2>
    {
      posts.length === 0 ? (
        <p class="empty-state text-center py-12">
          Todavía no hay posts publicados. ¡Volvé pronto!
        </p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
    <div class="text-center mt-10">
      <a href="/blog" class="text-sm font-medium link-more">
        Ver todos los posts →
      </a>
    </div>
  </div>
</section>

<style>
  .empty-state {
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  .link-more {
    color: var(--color-primary);
  }

  .link-more:hover {
    opacity: 0.8;
  }
</style>
