---
import type { Post } from "../../types/Post.ts";
import { getCollection } from "astro:content";

// Serie en video: el resumen (episodio 0) va primero; el home muestra solo 3.
const episodios = (await getCollection("serie"))
  .sort((a, b) => a.data.episodio - b.data.episodio)
  .slice(0, 3);

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let posts: Post[] = [];
let loadFailed = false;
try {
  const response = await fetch(`${apiBaseUrl}/posts/public`, {
    signal: AbortSignal.timeout(5000),
  });
  if (response.ok) posts = (await response.json()).posts ?? [];
  else loadFailed = true;
} catch (error) {
  console.error("No se pudo cargar posts:", error);
  loadFailed = true;
}

const formatDate = (isoString?: string) => {
  if (!isoString) return "";
  try {
    const d = new Date(isoString);
    return new Intl.DateTimeFormat("es-PE", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    }).format(d);
  } catch {
    return "";
  }
};
---

<section id="blog" class="py-20 lg:py-28 scroll-mt-24" aria-labelledby="blog-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="home-section-head">
      <div>
        <span class="label home-muted block mb-3">03 · Notas y serie</span>
        <h2 id="blog-title" class="display text-[clamp(2.25rem,5vw,3.5rem)]">Blog</h2>
      </div>
      {posts.length > 0 && <span class="label home-muted">{posts.length} registros</span>}
    </div>

    {
      episodios.length > 0 && (
        <ol class="hairline grid grid-cols-1 md:grid-cols-3 list-none m-0 p-0 mb-12">
          {episodios.map((ep, i) => (
            <li class:list={[i > 0 && "md:border-l border-t md:border-t-0"]} style="border-color: var(--hairline);">
              <a href={`/blog/serie/${ep.id}`} class="serie-card flex flex-col h-full transition-colors duration-150">
                <img
                  src={ep.data.imagen}
                  alt={ep.data.imagenAlt}
                  loading="lazy"
                  width="400"
                  height="224"
                  class="w-full h-48 object-cover object-[50%_38%] hairline-b"
                />
                <div class="flex flex-col flex-1 p-5 gap-3">
                  <p class="label home-muted">
                    {ep.data.episodio === 0 ? "Resumen de la serie" : `Episodio ${ep.data.episodio}`}
                  </p>
                  <h3 class="text-xl font-bold leading-snug">{ep.data.title}</h3>
                  <p class="text-sm leading-relaxed line-clamp-3 home-muted">{ep.data.descripcion}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    <div class={posts.length > 0 || episodios.length === 0 ? "hairline-t" : "hidden"}>
      {
        loadFailed && episodios.length === 0 ? (
          <div class="hairline-b py-6">
            <span class="label block mb-1" style="color: var(--color-action);">Error de carga</span>
            <p class="text-sm home-muted">No pudimos cargar los posts ahora. Intenta de nuevo en unos minutos.</p>
          </div>
        ) : posts.length === 0 ? (
          <div class="hairline-b py-6">
            <span class="label home-muted block mb-1">Sin datos</span>
            <p class="text-sm home-muted">Todavía no hay posts publicados. ¡Vuelve pronto!</p>
          </div>
        ) : (
          <ul class="list-none m-0 p-0">
            {posts.map((post) => {
              const formattedDate = formatDate(post.createdAt);
              return (
                <li class="post-row hairline-b grid grid-cols-1 md:grid-cols-[9rem_1fr_auto] gap-2 md:gap-6 md:items-center py-5 transition-colors duration-150">
                  <span class="label home-muted whitespace-nowrap">{formattedDate}</span>
                  <h3 class="text-[1.5rem] font-bold leading-tight min-w-0">{post.title}</h3>
                  <a href={`/blog/${post.slug}`} class="link-arrow text-sm min-h-11 md:justify-self-end" aria-label={`Leer post ${post.title}`}>
                    Leer <svg class="inline w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>

    <div class="mt-8">
      <a href="/blog" class="link-arrow text-sm">
        Ver todos los posts <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .serie-card:hover,
  .post-row:hover {
    background-color: var(--surface-2);
  }
</style>
