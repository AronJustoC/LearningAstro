---
import PostCard from "../shared/PostCard.astro";
import type { Post } from "../../types/Post.ts";

const response = await fetch(`${import.meta.env.API_BASE_URL}/posts`);
const responseData = await response.json();
const posts: Post[] = responseData.posts;
console.log(posts);
---

<section class="py-16">
  <div class="container max-w-6xl m-auto p-6">
    <h2 class="text-3xl font-bold text-center mb-8">Mis Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Ejemplo de Proyecto 1 -->
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</section>
