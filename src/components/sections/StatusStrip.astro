---
// Franja de estado superior: identidad + hora local (UTC-5) en vivo.
---

<div class="hairline-b" style="background: var(--surface-2);">
  <div
    class="max-w-7xl mx-auto px-6 lg:px-8 h-9 flex items-center justify-between label"
    style="color: color-mix(in srgb, var(--color-text) 72%, transparent);"
  >
    <span class="inline-flex items-center gap-2">
      <span
        class="inline-block w-1.5 h-1.5 rounded-full"
        style="background: var(--color-action);"
        aria-hidden="true"></span>
      Portafolio · Aron J. Choque
    </span>
    <span class="inline-flex items-center gap-3">
      <span class="hidden sm:inline">Cusco, PE</span>
      <span class="hidden sm:inline" aria-hidden="true">/</span>
      <span>UTC−5 <time id="statusClock" datetime="">--:--:--</time></span>
    </span>
  </div>
</div>

<script>
  const el = document.getElementById("statusClock");
  const fmt = new Intl.DateTimeFormat("es-PE", {
    timeZone: "America/Lima",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });
  const tick = () => {
    if (!el) return;
    el.textContent = fmt.format(new Date());
    el.setAttribute("datetime", new Date().toISOString());
  };
  tick();
  setInterval(tick, 1000);
</script>
