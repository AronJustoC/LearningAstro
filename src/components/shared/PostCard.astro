---
import type { Post } from "../../types/Post";
import EntityCard from "./EntityCard.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<EntityCard
  imageUrl={post.imageUrl}
  imageAlt={`Captura de pantalla del proyecto ${post.title}`}
  title={post.title}
  description={post.content}
  href={`/blog/${post.slug}`}
/>
