---
interface Props {
  imageUrl?: string;
  imageAlt: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

const {
  imageUrl,
  imageAlt,
  title,
  description,
  href,
  linkLabel = "Ver más",
} = Astro.props;
---

<article
  class="entity-card group flex flex-col justify-between rounded-[2px] hairline overflow-hidden transition-all duration-150 bg-[var(--color-bg)]"
>
  <div class="image-wrapper relative overflow-hidden">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={imageAlt}
          loading="lazy"
          width="400"
          height="192"
          class="w-full object-cover h-48 hairline-b"
        />
      ) : (
        <div class="image-placeholder w-full h-48 hairline-b flex items-center justify-center bg-[var(--surface-2)]">
          <span aria-hidden="true" class="label text-xl text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
            {title.slice(0, 2).toUpperCase()}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-col p-5 space-y-3 flex-1 justify-between">
    <div>
      <h2 class="text-xl font-bold leading-snug text-[var(--color-text)]">{title}</h2>
      <p class="text-sm leading-relaxed mt-2 text-[color-mix(in_srgb,var(--color-text)_75%,transparent)] line-clamp-3">
        {description}
      </p>
    </div>

    {
      href && (
        <div class="pt-2">
          <a
            href={href}
            target={href.startsWith("/") ? undefined : "_blank"}
            rel={href.startsWith("/") ? undefined : "noopener noreferrer"}
            class="link-arrow text-sm"
            aria-label={`${linkLabel} sobre ${title}`}
          >
            {linkLabel} <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
        </div>
      )
    }
  </div>
</article>

<style>
  .entity-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lift);
    border-color: var(--focus-color);
  }
</style>
