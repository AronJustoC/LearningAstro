---
import { optimizedImage } from "../../lib/image";

interface Props {
  imageUrl?: string;
  imageAlt: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

const {
  imageUrl,
  imageAlt,
  title,
  description,
  href,
  linkLabel = "Ver más",
} = Astro.props;
---

<article
  class="entity-card group flex flex-col justify-between rounded-[18px] overflow-hidden bg-[var(--color-bg)]"
>
  <div class="image-wrapper relative overflow-hidden p-3 pb-0">
    {
      imageUrl ? (
        <img
          src={optimizedImage(imageUrl, 800)}
          alt={imageAlt}
          loading="lazy"
          width="400"
          height="250"
          class="w-full object-cover aspect-[16/10] rounded-[18px]"
        />
      ) : (
        <div class="image-placeholder w-full aspect-[16/10] rounded-[18px] flex items-center justify-center bg-[var(--surface-2)]">
          <span aria-hidden="true" class="label text-xl text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
            {title.slice(0, 2).toUpperCase()}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-col p-5 space-y-3 flex-1 justify-between">
    <div>
      <h2 class="display uppercase font-bold text-xl leading-snug text-[var(--color-text)]">{title}</h2>
      <p class="text-sm leading-relaxed mt-2 text-[var(--color-text)]/70 line-clamp-3">
        {description}
      </p>
    </div>

    {
      href && (
        <div class="pt-2">
          <a
            href={href}
            target={href.startsWith("/") ? undefined : "_blank"}
            rel={href.startsWith("/") ? undefined : "noopener noreferrer"}
            class="link-arrow text-sm"
            aria-label={`${linkLabel} sobre ${title}`}
          >
            {linkLabel} <svg class="inline w-3.5 h-3.5 align-[-1px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
        </div>
      )
    }
  </div>
</article>


