---
// Fuente Outfit solo para la tienda; los tokens se aplican bajo .tienda-brand
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700&display=swap" rel="stylesheet" />

<style is:global>
  .tienda-brand {
    /* Musuq Studio: Terracota #B5523B, Arena #E6D3B3, Carbón #262422 */
    --color-bg: #ffffff;
    --color-text: #262422;
    --surface-2: #f6efe3;
    --color-primary: #b5523b;
    --color-primary-dark: #b5523b;
    --color-action: #b5523b;
    --color-on-action: #ffffff;
    --focus-color: #b5523b;
    --hairline: color-mix(in srgb, #262422 16%, transparent);
    --background: #ffffff;
    --foreground: #262422;
    --card: #f6efe3;
    --card-foreground: #262422;
    --primary: #b5523b;
    --primary-foreground: #ffffff;
    --ring: #b5523b;
    --border: color-mix(in srgb, #e6d3b3 90%, transparent);
    --font-display: "Outfit", "Jost", sans-serif;
    --font-heading: var(--font-display);
    --font-sans: var(--font-display);
    font-family: var(--font-display);
    background-color: var(--background);
    color: var(--foreground);
  }
  html.dark .tienda-brand {
    --color-bg: #262422;
    --color-text: #e6d3b3;
    --surface-2: #302d2a;
    --color-primary: #c8624a;
    --color-primary-dark: #b5523b;
    --color-action: #b5523b;
    --color-on-action: #ffffff;
    --focus-color: #e6d3b3;
    --hairline: color-mix(in srgb, #e6d3b3 18%, transparent);
    --background: #262422;
    --foreground: #e6d3b3;
    --card: #302d2a;
    --card-foreground: #e6d3b3;
    --primary: #b5523b;
    --primary-foreground: #ffffff;
    --ring: #e6d3b3;
    --border: color-mix(in srgb, #e6d3b3 22%, transparent);
  }
  .tienda-brand h1, .tienda-brand h2, .tienda-brand h3,
  .tienda-brand .display, .tienda-brand .label,
  .tienda-brand button, .tienda-brand .btn-block, .tienda-brand .chip {
    font-family: var(--font-display);
  }
</style>
