---
import type { Product } from "../../data/catalog";
import { minPriceCents, isSoldOut } from "../../data/catalog";
import { formatMoney } from "../../lib/store/pricing";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const firstImage = product.images[0];
const soldOut = isSoldOut(product);
const minPrice = formatMoney(minPriceCents(product));
---

<article class="group rounded-xl border border-border bg-card text-foreground overflow-hidden shadow-xs hover:shadow-md transition-shadow">
  <a
    href={`/tienda/producto/${product.slug}`}
    class="flex flex-col h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-xl"
  >
    <div class="relative aspect-square w-full bg-secondary/30 overflow-hidden">
      {
        firstImage && (
          <img
            src={firstImage.src}
            alt={firstImage.alt}
            width={400}
            height={400}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        )
      }
      {
        soldOut && (
          <span class="absolute top-3 right-3 rounded-md bg-secondary text-foreground text-xs font-semibold px-2 py-1 shadow-xs border border-border">
            Agotado
          </span>
        )
      }
    </div>

    <div class="p-4 flex flex-col flex-1 justify-between gap-2">
      <h2 class="font-display font-medium text-base text-foreground group-hover:text-primary transition-colors">
        {product.name}
      </h2>
      <p class="text-sm text-muted-foreground font-sans">
        desde <span class="font-medium text-foreground">{minPrice}</span>
      </p>
    </div>
  </a>
</article>