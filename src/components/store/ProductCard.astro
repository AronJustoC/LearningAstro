---
import type { Product } from "../../data/catalog";
import { minPriceCents, isSoldOut } from "../../data/catalog";
import { formatMoney } from "../../lib/store/pricing";
import { optimizedImage } from "../../lib/image";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const firstImage = product.images[0];
const soldOut = isSoldOut(product);
const minPrice = formatMoney(minPriceCents(product));
---

<article class="store-card group overflow-hidden">
  <a
    href={`/tienda/producto/${product.slug}`}
    class="flex flex-col h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-xl"
  >
    <div class="relative overflow-hidden">
      {
        firstImage && (
          <img
            src={optimizedImage(firstImage.src, 600)}
            alt={firstImage.alt}
            width={400}
            height={400}
            loading="lazy"
            class="store-media"
          />
        )
      }
      {
        soldOut && (
          <span class="absolute top-3 right-3 rounded-md bg-secondary text-foreground text-xs font-semibold px-2 py-1 shadow-xs border border-border">
            Agotado
          </span>
        )
      }
    </div>

    <div class="p-4 flex flex-col flex-1 justify-between gap-2">
      <h2 class="store-title">
        {product.name}
      </h2>
      <p class="store-price">{minPrice}</p>
    </div>
  </a>
</article>