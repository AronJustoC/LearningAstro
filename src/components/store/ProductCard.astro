---
import type { StoreProduct } from "../../lib/store/types";
import { minPriceCents, isAvailable } from "../../lib/store/catalog";
import { formatMoney } from "../../lib/store/pricing";
import { optimizedImage } from "../../lib/image";

interface Props {
  product: StoreProduct;
}

const { product } = Astro.props;
const firstImage = product.images[0];
const imageSrc = firstImage
  ? firstImage.startsWith("https://")
    ? optimizedImage(firstImage, 600) ?? firstImage
    : firstImage
  : undefined;
const soldOut = !isAvailable(product);
const priceLabel = `${product.variants.length > 1 ? "Desde " : ""}${formatMoney(minPriceCents(product))}`;
---

<article class="store-card group overflow-hidden">
  <a
    href={`/tienda/producto/${product.slug}`}
    class="flex flex-col h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-xl"
  >
    <div class="relative overflow-hidden">
      {
        imageSrc && (
          <img
            src={imageSrc}
            alt={product.name}
            width={400}
            height={400}
            loading="lazy"
            class="store-media"
          />
        )
      }
      {
        soldOut && (
          <span class="absolute top-3 right-3 rounded-md bg-secondary text-foreground text-xs font-semibold px-2 py-1 shadow-xs border border-border">
            Agotado
          </span>
        )
      }
    </div>

    <div class="p-4 flex flex-col flex-1 justify-between gap-2">
      <h2 class="store-title">
        {product.name}
      </h2>
      <p class="store-price">{priceLabel}</p>
    </div>
  </a>
</article>
