---
import { categories } from "../../data/catalog";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav aria-label="Categorías" class="py-2">
  <ul class="flex flex-wrap items-center gap-2 text-sm">
    <li>
      <a
        href="/tienda"
        aria-current={!current ? "page" : undefined}
        class:list={[
          "btn-glass",
          !current ? "border-primary bg-primary text-primary-foreground" : undefined,
        ]}
      >
        Todos
      </a>
    </li>
    {
      categories.map((cat) => {
        const isActive = current === cat.slug;
        return (
          <li>
            <a
              href={`/tienda/${cat.slug}`}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "btn-glass",
                isActive ? "border-primary bg-primary text-primary-foreground" : undefined,
              ]}
            >
              {cat.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>