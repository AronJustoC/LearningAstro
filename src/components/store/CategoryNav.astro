---
import { categories } from "../../data/catalog";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav aria-label="Categorías" class="overflow-x-auto py-2">
  <ul class="flex items-center gap-2 whitespace-nowrap text-sm">
    <li>
      <a
        href="/tienda"
        aria-current={!current ? "page" : undefined}
        class:list={[
          "px-3 py-1.5 rounded-lg border text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
          !current
            ? "border-primary bg-primary text-primary-foreground"
            : "border-border bg-card text-muted-foreground hover:text-foreground hover:bg-secondary",
        ]}
      >
        Todos
      </a>
    </li>
    {
      categories.map((cat) => {
        const isActive = current === cat.slug;
        return (
          <li>
            <a
              href={`/tienda/${cat.slug}`}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "px-3 py-1.5 rounded-lg border text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
                isActive
                  ? "border-primary bg-primary text-primary-foreground"
                  : "border-border bg-card text-muted-foreground hover:text-foreground hover:bg-secondary",
              ]}
            >
              {cat.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>