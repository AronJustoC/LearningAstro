---
interface Props {
  title: string;
  text: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, text, ctaHref, ctaLabel } = Astro.props;
---

<div class="store-card flex flex-col items-center justify-center text-center max-w-md mx-auto my-8">
  <h2 class="store-title font-medium text-lg text-foreground mb-2">
    {title}
  </h2>
  <p class="text-sm text-muted-foreground mb-6">
    {text}
  </p>
  {
    ctaHref && ctaLabel && (
      <a
        href={ctaHref}
        class="btn-glass"
      >
        {ctaLabel}
      </a>
    )
  }
</div>