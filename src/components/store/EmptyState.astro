---
interface Props {
  title: string;
  text: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, text, ctaHref, ctaLabel } = Astro.props;
---

<div class="flex flex-col items-center justify-center text-center p-8 sm:p-12 border border-dashed border-border rounded-xl bg-card/50 max-w-md mx-auto my-8">
  <h2 class="font-display font-medium text-lg text-foreground mb-2">
    {title}
  </h2>
  <p class="text-sm text-muted-foreground mb-6">
    {text}
  </p>
  {
    ctaHref && ctaLabel && (
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground font-medium text-sm px-4 py-2 hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring transition-colors"
      >
        {ctaLabel}
      </a>
    )
  }
</div>