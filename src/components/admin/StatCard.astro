---
import {
  Card,
  CardHeader,
  CardTitle,
  CardContent,
} from "../ui/card";

interface Props {
  title: string;
  value: string | number;
}

const { title, value } = Astro.props;
---

<Card>
  <CardHeader>
    <CardTitle className="text-sm font-medium text-muted-foreground">
      {title}
    </CardTitle>
  </CardHeader>
  <CardContent>
    <p class="text-3xl font-bold">{value}</p>
  </CardContent>
</Card>
