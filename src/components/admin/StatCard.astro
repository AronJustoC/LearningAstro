---
interface Props {
  title: string;
  value: string | number;
}

const { title, value } = Astro.props;
---

<div class="flex flex-col gap-3 rounded-[2px] border border-[var(--hairline)] bg-[var(--color-bg)] p-6">
  <p class="label text-xs uppercase tracking-wider text-[var(--color-text)]/70">{title}</p>
  <p class="display text-5xl leading-none tabular-nums text-[var(--color-text)]">{value}</p>
</div>
