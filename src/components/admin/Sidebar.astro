---
const pathname = Astro.url.pathname;

const items = [
  { href: "/admin/dashboard", label: "Dashboard" },
  { href: "/admin/posts", label: "Posts" },
  { href: "/admin/projects", label: "Proyectos" },
  { href: "/admin/cursos", label: "Cursos" },
  { href: "/admin/tienda", label: "Tienda" },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);

const linkBase =
  "flex min-h-10 items-center rounded-[2px] px-3 text-sm font-semibold transition-colors duration-200 whitespace-nowrap";
const linkIdle =
  "text-[var(--color-text)] hover:bg-[var(--hairline)]";
const linkActive =
  "bg-[color-mix(in_srgb,var(--color-action)_14%,transparent)] text-[var(--color-action)]";
---

<aside
  class="flex flex-col gap-6 border-b border-[var(--hairline)] bg-[var(--surface-2)] px-4 py-5 md:sticky md:top-0 md:min-h-screen md:w-60 md:border-b-0 md:border-r"
>
  <div class="flex items-center justify-between gap-3 px-2">
    <a
      href="/admin/dashboard"
      class="display text-xl uppercase leading-none tracking-tight text-[var(--color-text)]"
    >
      ARON J. CHOQUE
    </a>
    <span class="label text-[var(--color-action)]">Admin</span>
  </div>

  <nav aria-label="Administración" class="flex flex-1 flex-col gap-4">
    <ul class="flex gap-1 overflow-x-auto md:flex-col md:overflow-visible">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[linkBase, isActive(item.href) ? linkActive : linkIdle]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col gap-1 border-t border-[var(--hairline)] pt-4 md:mt-auto">
      <a
        href="/"
        class={`${linkBase} ${linkIdle} text-[var(--color-text)]/70`}
      >
        Volver al sitio
      </a>
      <button
        id="logoutBtn"
        type="button"
        class={`${linkBase} w-full text-left text-[var(--destructive)] hover:bg-[color-mix(in_srgb,var(--destructive)_10%,transparent)]`}
      >
        Cerrar sesión
      </button>
    </div>
  </nav>
</aside>

<script>
  document.getElementById("logoutBtn")?.addEventListener("click", () => {
    localStorage.removeItem("accessToken");
    document.cookie = "token=; path=/; max-age=0";
    window.location.href = "/auth/login";
  });
</script>
