---
import "../styles/global.css";
import Sidebar from "../components/admin/Sidebar.astro";
const { title, description } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <!--Evitar parpadeo de tema verificando preferencia-->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme:dark)",
        ).matches;

        if (savedTheme === "dark" || (!savedTheme && systemPrefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="admin-shell bg-background text-foreground font-sans antialiased">
    <div class="flex min-h-screen flex-col md:flex-row">
      <Sidebar />
      <main class="min-w-0 flex-1 px-5 py-8 md:px-10 md:py-12">
        <div class="mx-auto w-full max-w-5xl">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  .admin-shell :focus-visible {
    outline: 2px solid var(--focus-color);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .admin-shell ::selection {
    background: color-mix(in srgb, var(--color-action) 28%, transparent);
  }
</style>
