---
interface Props {
  title: string
}
const {title} = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #f8f8f8;
        font-family: sans-serif;
      }
      header, footer {
        background-color: #333;
        color: white;
        padding: 1rem;
        text-align: center;
      }
    </style>
    <link href="css/style.css" rel="stylesheet">
  </head>
  <body>
    <header><h1>Mi sitio Astro</h1></header>
    <main>
    <!--Aqui se injectara cada pagina-->
      <slot/>
    </main>
    <footer><p>Hecho con ❤ y Astro</p></footer>
  </body>
</html>
