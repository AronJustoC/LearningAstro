---
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import ProjectsManager from "../../components/admin/ProjectsManager";
import PageHeader from "../../components/admin/PageHeader.astro";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/auth/login");
}
---

<LayoutDashboard title="Gestionar Proyectos">
  <PageHeader
    title="Proyectos"
    description="Proyectos que aparecen en la sección pública de proyectos."
  />
  <ProjectsManager client:load />
</LayoutDashboard>
