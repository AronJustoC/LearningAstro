---
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import PostsManager from "../../components/admin/PostsManager";
import PageHeader from "../../components/admin/PageHeader.astro";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/auth/login");
}
---

<LayoutDashboard title="Gestionar Posts">
  <PageHeader
    title="Posts"
    description="Crea y borra artículos del blog."
  />
  <PostsManager client:load />
</LayoutDashboard>
