---
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import StatCard from "../../components/admin/StatCard.astro";
import PageHeader from "../../components/admin/PageHeader.astro";
import AdminStoreOrders from "../../components/store/AdminStoreOrders";
import { categories, products, minPriceCents, isSoldOut } from "../../data/catalog";
import { formatMoney } from "../../lib/store/pricing";
import { readRole } from "../../lib/session";

const token = Astro.cookies.get("token")?.value;
const role = readRole(token);
if (!role) {
  return Astro.redirect("/auth/login");
}
if (role !== "ADMIN") {
  return Astro.redirect("/mis-cursos");
}

const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
---

<LayoutDashboard title="Admin Tienda">
  <PageHeader
    title="Tienda"
    description="Catálogo y pedidos de la tienda (solo lectura)."
  />
  <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 mt-8">
    <StatCard title="Total Productos" value={products.length} />
    <StatCard title="Total Categorías" value={categories.length} />
  </div>

  <div class="mt-10 overflow-x-auto border border-[var(--hairline)] bg-[var(--color-bg)]">
    <table class="w-full text-left text-sm">
      <thead class="label text-[var(--color-text)]/70">
        <tr class="border-b border-[var(--hairline)]">
          <th class="px-4 py-3 font-normal">Producto</th>
          <th class="px-4 py-3 font-normal">Categoría</th>
          <th class="px-4 py-3 font-normal">Desde</th>
          <th class="px-4 py-3 font-normal">Estado</th>
        </tr>
      </thead>
      <tbody>
        {
          products.map((product) => (
            <tr class="border-b border-[var(--hairline)] last:border-b-0 text-[var(--color-text)]">
              <td class="px-4 py-3">{product.name}</td>
              <td class="px-4 py-3 text-[var(--color-text)]/70">{categoryName(product.categorySlug)}</td>
              <td class="px-4 py-3 tabular-nums">{formatMoney(minPriceCents(product))}</td>
              <td class="px-4 py-3 text-[var(--color-text)]/70">
                {isSoldOut(product) ? "Agotado" : "Disponible"}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="mt-10">
    <h2 class="label mb-4 text-[var(--color-text)]/70">Pedidos de este navegador</h2>
    <AdminStoreOrders client:only="react" />
  </section>
</LayoutDashboard>
