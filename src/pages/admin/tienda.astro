---
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import PageHeader from "../../components/admin/PageHeader.astro";
import StoreManager from "../../components/admin/StoreManager";
import AdminStoreOrders from "../../components/store/AdminStoreOrders";
import { readRole } from "../../lib/session";

const token = Astro.cookies.get("token")?.value;
const role = readRole(token);
if (!role) {
  return Astro.redirect("/auth/login");
}
if (role !== "ADMIN") {
  return Astro.redirect("/mis-cursos");
}
---

<LayoutDashboard title="Admin Tienda">
  <PageHeader
    title="Tienda"
    description="Productos, categorías y stock de la tienda."
  />

  <div class="mt-8">
    <StoreManager client:load />
  </div>

  <section class="mt-10">
    <h2 class="label mb-4 text-[var(--color-text)]/70">Pedidos de este navegador</h2>
    <AdminStoreOrders client:only="react" />
  </section>
</LayoutDashboard>
