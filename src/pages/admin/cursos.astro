---
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import CoursesManager from "../../components/admin/CoursesManager";
import PageHeader from "../../components/admin/PageHeader.astro";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/auth/login");
}
---

<LayoutDashboard title="Gestionar Cursos">
  <PageHeader
    title="Cursos"
    description="Crea cursos con lecciones, video, capítulos y adjuntos."
  />
  <CoursesManager client:load />
</LayoutDashboard>
