---
import LayoutBase from "../../layouts/LayoutBase.astro";
import StoreBrand from "../../components/store/StoreBrand.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import ProductCard from "../../components/store/ProductCard.astro";
import CategoryNav from "../../components/store/CategoryNav.astro";
import EmptyState from "../../components/store/EmptyState.astro";
import StoreHeader from "../../components/store/StoreHeader.astro";
import { products } from "../../data/catalog";
import { STORE_NAME } from "../../config/store";
---

<LayoutBase title={`${STORE_NAME} | Tienda`} description="Piezas impresas en 3D: figuras, organizadores, macetas y más.">
  <Header />
  <main id="main" class="flex-1 tienda-brand">
    <StoreBrand />
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-8">
          <StoreHeader num="01" label="TIENDA" title={STORE_NAME} />
          <p class="text-sm text-muted-foreground mt-2">
            Explora todas nuestras piezas impresas en 3D de diseño exclusivo.
          </p>
          <div class="mt-6">
            <CategoryNav />
          </div>
        </div>

        {
          products.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {products.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          ) : (
            <EmptyState
              title="No hay productos disponibles"
              text="Actualmente no encontramos productos en el catálogo."
              ctaHref="/"
              ctaLabel="Volver al inicio"
            />
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
