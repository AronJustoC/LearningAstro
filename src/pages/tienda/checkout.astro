---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import CheckoutForm from "../../components/store/CheckoutForm";
---

<LayoutBase title="Checkout" description="Completa tus datos de envío para confirmar el pedido.">
  <Header />
  <main id="main" class="flex-1">
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left mb-8 text-[var(--color-text)]">Checkout</h1>
        <CheckoutForm client:only="react">
          <div slot="fallback">
            <div class="space-y-3" aria-hidden="true">
              <div class="h-24 animate-pulse rounded-xl bg-muted"></div>
              <div class="h-24 animate-pulse rounded-xl bg-muted"></div>
              <div class="h-32 animate-pulse rounded-xl bg-muted"></div>
            </div>
            <p class="sr-only">Cargando checkout</p>
          </div>
        </CheckoutForm>
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
