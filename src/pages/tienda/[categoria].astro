---
import LayoutBase from "../../layouts/LayoutBase.astro";
import StoreBrand from "../../components/store/StoreBrand.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import ProductCard from "../../components/store/ProductCard.astro";
import CategoryNav from "../../components/store/CategoryNav.astro";
import EmptyState from "../../components/store/EmptyState.astro";
import StoreHeader from "../../components/store/StoreHeader.astro";
import StoreTopbar from "../../components/store/StoreTopbar.astro";
import { loadCatalog, getCategoryBySlug, productsByCategorySlug, type Catalog } from "../../lib/store/catalog";

const { categoria } = Astro.params;
// Si el backend no responde, la página muestra el estado vacío en vez de 500.
let catalog: Catalog = { products: [], categories: [] };
try {
  catalog = await loadCatalog();
} catch (error) {
  console.error("No se pudo cargar el catálogo de la tienda:", error);
}
const category = categoria ? getCategoryBySlug(catalog, categoria) : undefined;
if (!category) Astro.response.status = 404;
const categoryProducts = category ? productsByCategorySlug(catalog, category.slug) : [];
---

<LayoutBase
  title={category ? `${category.name} | Tienda` : "Categoría no encontrada | Tienda"}
  description={category?.description ?? "Categoría no encontrada"}
>
  <Header />
  <main id="main" class="flex-1 tienda-brand">
    <StoreBrand />
    <StoreTopbar />
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-8">
          <StoreHeader num="01" label="TIENDA" title={category?.name ?? "Categoría no encontrada"} />
          <p class="text-sm text-muted-foreground mt-2">
            {category?.description}
          </p>
          <div class="mt-6">
            <CategoryNav categories={catalog.categories} current={category?.slug} />
          </div>
        </div>

        {
          category ? (
            categoryProducts.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {categoryProducts.map((product) => (
                  <ProductCard product={product} />
                ))}
              </div>
            ) : (
              <EmptyState
                title={`No hay productos en ${category.name}`}
                text="Por el momento no hay piezas disponibles en esta categoría."
                ctaHref="/tienda"
                ctaLabel="Ver todo el catálogo"
              />
            )
          ) : (
            <EmptyState
              title="Categoría no encontrada"
              text="La categoría que buscas no existe o ya no está disponible."
              ctaHref="/tienda"
              ctaLabel="Ver todo el catálogo"
            />
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
