---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import CartView from "../../components/store/CartView";
---

<LayoutBase title="Carrito" description="Revisa los productos de tu carrito.">
  <Header />
  <main id="main" class="flex-1 tienda-brand">
    <StoreBrand />
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left mb-8 text-[var(--color-text)]">Carrito</h1>
        <CartView client:only="react">
          <div slot="fallback">
            <div class="space-y-3" aria-hidden="true">
              <div class="h-24 animate-pulse rounded-xl bg-muted"></div>
              <div class="h-24 animate-pulse rounded-xl bg-muted"></div>
              <div class="h-32 animate-pulse rounded-xl bg-muted"></div>
            </div>
            <p class="sr-only">Cargando carrito</p>
          </div>
        </CartView>
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
