---
import LayoutBase from "../../../layouts/LayoutBase.astro";
import StoreBrand from "../../../components/store/StoreBrand.astro";
import Header from "../../../components/sections/Header.astro";
import Footer from "../../../components/sections/Footer.astro";
import Gallery from "../../../components/store/Gallery";
import ProductBuy from "../../../components/store/ProductBuy";
import CartBadge from "../../../components/store/CartBadge";
import EmptyState from "../../../components/store/EmptyState.astro";
import { loadCatalog, getProductBySlug } from "../../../lib/store/catalog";

const { slug } = Astro.params;
const catalog = await loadCatalog();
const product = slug ? getProductBySlug(catalog, slug) : undefined;
if (!product) Astro.response.status = 404;
const category = product
  ? product.category ?? catalog.categories.find((c) => c.id === product.categoryId)
  : undefined;
---

<LayoutBase
  title={product ? product.name : "Producto no encontrado"}
  description={product?.description ?? "Producto no encontrado"}
>
  <Header />
  <main id="main" class="flex-1 tienda-brand">
    <StoreBrand />
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        {
          product && (
            <div class="mb-6 flex items-center justify-between gap-4">
              <nav aria-label="Ruta" class="text-sm text-muted-foreground">
                <ol class="flex flex-wrap items-center gap-2">
                  <li><a class="rounded hover:underline focus-visible:ring-3 focus-visible:ring-ring/50" href="/">Inicio</a></li>
                  <li aria-hidden="true">/</li>
                  <li><a class="rounded hover:underline focus-visible:ring-3 focus-visible:ring-ring/50" href="/tienda">Catálogo</a></li>
                  <li aria-hidden="true">/</li>
                  <li>{category?.name ?? product.categoryId}</li>
                  <li aria-hidden="true">/</li>
                  <li aria-current="page" class="text-foreground">{product.name}</li>
                </ol>
              </nav>
              <CartBadge client:load />
            </div>
          )
        }

        {
          product ? (
            <div class="grid gap-8 lg:grid-cols-2">
              <Gallery client:visible images={product.images} alt={product.name} />

              <div class="space-y-5">
                <h1 class="display text-3xl">{product.name}</h1>
                <p class="text-muted-foreground">{product.description}</p>
                <ProductBuy client:only="react" product={product} />
              </div>
            </div>
          ) : (
            <EmptyState
              title="Producto no encontrado"
              text="La pieza que buscas no existe o ya no está disponible."
              ctaHref="/tienda"
              ctaLabel="Ver todo el catálogo"
            />
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
