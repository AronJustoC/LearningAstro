---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import AuthDialog from "../../components/auth/AuthDialog";
import type { Post } from "../../types/Post";

const { slug } = Astro.params;
const response = await fetch(
  `${process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL}/posts/public/${slug}`,
);

if (!response.ok) {
  return new Response(null, { status: 404 });
}

const { post }: { post: Post } = await response.json();
---

<LayoutBase title={`${post.title} | Blog`}>
  <Header />
  <main class="flex-1">
    <article class="py-16">
      <div class="container max-w-3xl m-auto p-6 space-y-6">
        {
          post.imageUrl && (
            <img
              src={post.imageUrl}
              alt={post.title}
              class="w-full rounded-xl object-cover max-h-96"
            />
          )
        }
        <h1 class="text-3xl md:text-4xl font-bold">{post.title}</h1>
        {
          post.author?.username && (
            <p class="text-sm opacity-60">Por {post.author.username}</p>
          )
        }
        <div class="prose max-w-none leading-relaxed whitespace-pre-line">
          {post.content}
        </div>
        <div class="flex items-center justify-between">
          <a href="/blog" class="inline-block text-sm font-medium link-back">
            ← Volver al blog
          </a>
          <AuthDialog client:load />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</LayoutBase>

<style>
  .link-back {
    color: var(--color-primary);
  }
</style>
