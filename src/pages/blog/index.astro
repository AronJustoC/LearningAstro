---
import { getCollection } from "astro:content";
import LayoutBase from "../../layouts/LayoutBase.astro";
const todasLasEntradas = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<LayoutBase title="Mi blog">
  <h1>Mi blog</h1>
  <p>Aqui estan todos los posts</p>
  <ul>
    {
      todasLasEntradas.map((entrada) => (
        <li>
          <a href={`/blog/${entrada.slug}`}>{entrada.data.title}</a>
        </li>
      ))
    }
  </ul>
</LayoutBase>
