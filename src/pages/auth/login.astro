---
import LayoutBase from "../../layouts/LayoutBase.astro";
import AuthModal from "../../components/auth/AuthModal.astro";
import LoginForm from "../../components/auth/LoginForm";
---

<LayoutBase title="Iniciar sesión | Aron J." noindex>
  <main id="main" class="min-h-screen">
    <AuthModal titleId="auth-title">
      <h1 id="auth-title" class="display pr-10 text-4xl leading-none tracking-tight text-[var(--color-text)]">
        Iniciar sesión
      </h1>
      <p class="mt-3 text-base text-[var(--color-text)]/70">
        Entra para ver tus cursos o administrar el sitio.
      </p>
      <div class="mt-7">
        <LoginForm client:load />
      </div>
      <p class="mt-6 text-sm text-[var(--color-text)]/70">
        ¿No tienes cuenta?
        <a href="/auth/register" class="link-arrow ml-1">Crear cuenta</a>
      </p>
    </AuthModal>
  </main>
</LayoutBase>
