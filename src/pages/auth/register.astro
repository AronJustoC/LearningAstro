---
import LayoutBase from "../../layouts/LayoutBase.astro";
import AuthModal from "../../components/auth/AuthModal.astro";
import RegisterForm from "../../components/auth/RegisterForm";
---

<LayoutBase title="Crear cuenta | Aron J." noindex>
  <main id="main" class="min-h-screen">
    <AuthModal titleId="auth-title">
      <h1 id="auth-title" class="display pr-10 text-4xl leading-none tracking-tight text-[var(--color-text)]">
        Crear cuenta
      </h1>
      <p class="mt-3 text-base text-[var(--color-text)]/70">
        Con una cuenta te inscribes en cursos y guardas tu avance.
      </p>
      <div class="mt-7">
        <RegisterForm client:load />
      </div>
      <p class="mt-6 text-sm text-[var(--color-text)]/70">
        ¿Ya tienes cuenta?
        <a href="/auth/login" class="link-arrow ml-1 font-semibold">Iniciar sesión</a>
      </p>
    </AuthModal>
  </main>
</LayoutBase>
