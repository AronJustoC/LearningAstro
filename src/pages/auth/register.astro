---
import LayoutBase from "../../layouts/LayoutBase.astro";
import RegisterForm from "../../components/auth/RegisterForm";
---

<LayoutBase title="Crear cuenta | Aron J." noindex>
  <main id="main" class="flex min-h-screen flex-col items-center justify-center px-5 py-12">
    <div class="w-full max-w-sm">
      <a
        href="/"
        class="display text-xl leading-none tracking-tight text-[var(--color-text)] rounded-[2px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        ARON J.
      </a>

      <h1 class="display mt-12 text-5xl leading-none tracking-tight text-[var(--color-text)]">
        Crear cuenta
      </h1>
      <p class="mt-3 text-[var(--color-text)]/70">
        Con una cuenta te inscribes en cursos y guardas tu avance.
      </p>

      <div class="mt-8">
        <RegisterForm client:load />
      </div>

      <p class="mt-8 text-sm text-[var(--color-text)]/70">
        ¿Ya tienes cuenta?
        <a href="/auth/login" class="link-arrow ml-1 font-semibold">Iniciar sesión</a>
      </p>
    </div>
  </main>
</LayoutBase>
