---
import LayoutBase from "../layouts/LayoutBase.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Projects from "../components/sections/Projects.astro";
import TechCarousel from "../components/sections/TechCarousel.astro";
import Footer from "../components/sections/Footer.astro";
import Posts from "../components/sections/Posts.astro";
import { CONTACT_EMAIL, TIKTOK_URL } from "../lib/contact";

const site = "https://aronjusto.site";
// Datos estructurados: quién es y qué ofrece, para que buscadores y asistentes lo entiendan.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site}/#persona`,
    name: "Aron Justo Choque Chauca",
    alternateName: ["Aron Justo", "Aron Justo Choque", "Aron J. Choque"],
    jobTitle: "Desarrollador de software",
    description:
      "Desarrollo software a medida para empresas: plataformas web, sistemas, automatización de procesos y agentes de IA.",
    url: site,
    image: `${site}/og-default.png`,
    email: CONTACT_EMAIL,
    address: { "@type": "PostalAddress", addressLocality: "Cusco", addressCountry: "PE" },
    knowsAbout: ["Desarrollo web", "Automatización de procesos", "Agentes de IA", "Android", "Astro", "React"],
    sameAs: ["https://github.com/AronJustoC", "https://www.linkedin.com/in/aronjusto/", TIKTOK_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}/#sitio`,
    name: "Aron Justo Choque Chauca",
    alternateName: "Aron Justo",
    url: site,
    inLanguage: "es",
    publisher: { "@id": `${site}/#persona` },
  },
];
---

<LayoutBase
  title="Aron J. | Software a medida para empresas"
  description="Desarrollo plataformas web, sistemas a medida, automatización de procesos y agentes de IA para empresas. Te acompaño desde la idea hasta que funciona."
  jsonLd={jsonLd}
>
  <Header />
  <main id="main" class="flex-1" data-home-motion>
    <Hero />
    <Projects />
    <TechCarousel />
    <Posts />
  </main>
  <Footer />
</LayoutBase>

<script>
  // Único movimiento en el home: el hero sube en CSS (.hero-rise) y las filas
  // aparecen al entrar en pantalla. Con reduced-motion todo queda visible.
  const motionPreference = window.matchMedia("(prefers-reduced-motion: no-preference)");

  if (motionPreference.matches) {
    const easeOutExpo = "cubic-bezier(.16, 1, .3, 1)";
    const revealRows = Array.from(document.querySelectorAll<HTMLElement>(".motion-reveal-row"));
    let observer: IntersectionObserver | undefined;

    const revealRow = (row: HTMLElement, delay = 0) => {
      if (row.classList.contains("motion-revealed")) return;

      const rowAnimation = row.animate(
        [
          { opacity: 0, transform: "translateY(10px)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: 380, delay, easing: easeOutExpo, fill: "forwards" },
      );

      rowAnimation.finished
        .then(() => {
          row.classList.add("motion-revealed");
          rowAnimation.cancel();
        })
        .catch(() => {});
    };

    const revealAll = () => {
      revealRows.forEach((row) => {
        observer?.unobserve(row);
        row.classList.add("motion-revealed");
      });
    };

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          entries
            .filter((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.15)
            .sort((a, b) => {
              const position = a.target.compareDocumentPosition(b.target);
              return position & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
            })
            .forEach((entry, index) => {
              const row = entry.target as HTMLElement;
              observer?.unobserve(row);
              revealRow(row, index * 60);
            });
        },
        { threshold: 0.15 },
      );
      revealRows.forEach((row) => observer?.observe(row));
    } else {
      revealAll();
    }

    // Red de seguridad: nada queda oculto si el observer no dispara.
    window.setTimeout(revealAll, 1500);
  }
</script>
