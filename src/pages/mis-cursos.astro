---
import LayoutBase from "../layouts/LayoutBase.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import MyCourses from "../components/student/MyCourses";
---

<LayoutBase
  title="Mis cursos | Aron J."
  description="Mis cursos inscritos y progreso de lecciones."
  noindex
>
  <Header />
  <main id="main" class="flex-1">
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left text-[var(--color-text)]">
            Mis cursos
          </h1>
        </div>
        <MyCourses client:load />
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>
