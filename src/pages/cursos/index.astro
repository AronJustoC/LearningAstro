---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import type { Course } from "../../types/Course";

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let courses: Course[] = [];
let loadFailed = false;
try {
  const response = await fetch(`${apiBaseUrl}/courses/public`, {
    signal: AbortSignal.timeout(5000),
  });
  if (response.ok) courses = (await response.json()).courses ?? [];
  else loadFailed = true;
} catch (error) {
  console.error("No se pudo cargar cursos:", error);
  loadFailed = true;
}
---

<LayoutBase
  title="Cursos | Aron J."
  description="Cursos para aprender construyendo: lecciones cortas, problemas reales y el código a la vista."
>
  <Header />
  <main id="main" class="flex-1">
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="home-section-head motion-reveal-row">
          <p class="label">01 · CURSOS</p>
          <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left text-[var(--color-text)]">
            Cursos
          </h1>
        </div>
        {
          courses.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {courses.map((course) => (
                <a
                  href={`/cursos/${course.slug}`}
                  class="motion-reveal-row serie-card group flex flex-col h-full rounded-[2px] hairline overflow-hidden bg-[var(--color-bg)] transition-all duration-150"
                >
                  {course.imageUrl && (
                    <img
                      src={course.imageUrl}
                      alt={course.title}
                      loading="lazy"
                      width="400"
                      height="224"
                      class="w-full h-56 object-cover object-[50%_38%] hairline-b"
                    />
                  )}
                  <div class="flex flex-col flex-1 p-5 gap-3">
                    <h2 class="text-xl font-bold leading-snug text-[var(--color-text)]">{course.title}</h2>
                    {course.description && (
                      <p class="text-sm leading-relaxed line-clamp-3" style="color: color-mix(in srgb, var(--color-text) 75%, transparent);">
                        {course.description}
                      </p>
                    )}
                    <p class="label mt-auto pt-2" style="color: color-mix(in srgb, var(--color-text) 68%, transparent);">
                      {course.lessonCount ?? 0} {(course.lessonCount ?? 0) === 1 ? "lección" : "lecciones"}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          )
        }
        {
          courses.length === 0 && (
            <div class="hairline-t hairline-b py-6">
              <span class="label block mb-1" style={loadFailed ? "color: var(--color-action);" : undefined}>
                {loadFailed ? "Error de carga" : "Sin datos"}
              </span>
              <p class="text-sm" style="color: color-mix(in srgb, var(--color-text) 75%, transparent);">
                {loadFailed
                  ? "No pudimos cargar los cursos ahora. Intenta de nuevo en unos minutos."
                  : "Todavía no hay cursos publicados."}
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>

<style>
  .serie-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lift);
    border-color: var(--focus-color);
  }
</style>
