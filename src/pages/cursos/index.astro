---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import type { Course } from "../../types/Course";
import { optimizedImage } from "../../lib/image";

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let courses: Course[] = [];
let loadFailed = false;
try {
  const response = await fetch(`${apiBaseUrl}/courses/public`, {
    signal: AbortSignal.timeout(5000),
  });
  if (response.ok) courses = (await response.json()).courses ?? [];
  else loadFailed = true;
} catch (error) {
  console.error("No se pudo cargar cursos:", error);
  loadFailed = true;
}

---

<LayoutBase
  title="Cursos | Aron J."
  description="Cursos para aprender construyendo: lecciones cortas, problemas reales y el código a la vista."
>
  <Header />
  <main id="main" class="flex-1">
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="home-section-head motion-reveal-row">
          <p class="label">01 · CURSOS</p>
          <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left text-[var(--color-text)]">
            Cursos
          </h1>
        </div>
        {
          courses.length > 0 && (
            <div class="hairline-t mt-8">
              {courses.map((course) => (
                <a
                  href={`/cursos/${course.slug}`}
                  class="course-row motion-reveal-row group flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 py-5 hairline-b transition-colors"
                >
                  <span class="course-thumb shrink-0 w-24 h-16 sm:w-40 sm:h-24 rounded-[2px] hairline overflow-hidden bg-[var(--surface-2)]">
                    {course.imageUrl ? (
                      <img
                        src={optimizedImage(course.imageUrl, 400)}
                        alt={course.title}
                        loading="lazy"
                        width="160"
                        height="96"
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <img
                        src="/brand/marca.svg"
                        alt=""
                        aria-hidden="true"
                        class="w-full h-full object-contain p-3"
                      />
                    )}
                  </span>
                  <div class="min-w-0 flex-1 space-y-1">
                    <p class="label" style="color: var(--color-action);">Curso</p>
                    <h2 class="display text-[1.5rem] sm:text-[1.75rem] leading-tight text-[var(--color-text)]">
                      {course.title}
                    </h2>
                    {course.description && (
                      <p class="text-sm leading-relaxed line-clamp-1" style="color: color-mix(in srgb, var(--color-text) 75%, transparent);">
                        {course.description}
                      </p>
                    )}
                  </div>
                  <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
                    <span class="label" style="color: color-mix(in srgb, var(--color-text) 68%, transparent);">
                      {course.lessonCount ?? 0} {(course.lessonCount ?? 0) === 1 ? "lección" : "lecciones"}
                    </span>
                    <span class="link-arrow text-sm inline-flex items-center gap-1">
                      Ver curso
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          )
        }
        {
          courses.length === 0 && (
            <div class="hairline-t hairline-b py-6">
              <span class="label block mb-1" style={loadFailed ? "color: var(--color-action);" : undefined}>
                {loadFailed ? "Error de carga" : "Sin datos"}
              </span>
              <p class="text-sm" style="color: color-mix(in srgb, var(--color-text) 75%, transparent);">
                {loadFailed
                  ? "No pudimos cargar los cursos ahora. Intenta de nuevo en unos minutos."
                  : "Todavía no hay cursos publicados."}
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>

<style>
  .course-row:hover {
    background: var(--surface-2);
  }
  .course-row:hover .link-arrow {
    color: var(--color-action);
  }
</style>
