---
import LayoutBase from "../../layouts/LayoutBase.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import CoursePlayer from "../../components/student/CoursePlayer";
import type { Course } from "../../types/Course";

const { slug } = Astro.params;
const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let course: Course | null = null;

try {
  const response = await fetch(
    `${apiBaseUrl}/courses/public/${slug}`,
    { signal: AbortSignal.timeout(5000) },
  );
  if (response.ok) course = (await response.json()).course ?? null;
} catch (error) {
  console.error("No se pudo cargar el curso:", error);
}

// Igual que 404.astro: se responde 404 en la misma request.
if (!course) Astro.response.status = 404;
---

{
  !course ? (
    <LayoutBase
      title="Página no encontrada | Aron J. Choque"
      description="La página que buscas no existe o cambió de lugar."
      noindex
    >
      <Header />
      <main id="main" class="flex-1">
        <section class="py-24 lg:py-32">
          <div class="max-w-3xl mx-auto px-6 space-y-6">
            <p class="label" style="color: var(--color-action);">Error 404</p>
            <h1 class="display" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">Este curso no existe</h1>
            <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--color-text) 78%, transparent);">
              El enlace puede estar mal escrito o el curso cambió de lugar.
            </p>
            <ul class="hairline-t">
              <li class="hairline-b"><a class="link-arrow flex min-h-14 items-center" href="/">Inicio</a></li>
              <li class="hairline-b"><a class="link-arrow flex min-h-14 items-center" href="/cursos">Cursos</a></li>
              <li class="hairline-b"><a class="link-arrow flex min-h-14 items-center" href="/blog">Blog</a></li>
              <li class="hairline-b"><a class="link-arrow flex min-h-14 items-center" href="/contacto">Contacto</a></li>
            </ul>
          </div>
        </section>
      </main>
      <Footer />
    </LayoutBase>
  ) : (
    <LayoutBase title={`${course.title} | Cursos`} description={course.description ?? undefined}>
      <Header />
      <main id="main" class="flex-1">
        <article class="py-16 lg:py-20">
          <div class="max-w-6xl mx-auto px-6 space-y-6">
            {course.imageUrl && (
              <img
                src={course.imageUrl}
                alt={course.title}
                class="w-full rounded-[2px] hairline object-cover max-h-96"
              />
            )}
            <h1 class="display" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">{course.title}</h1>
            {course.description && (
              <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--color-text) 78%, transparent);">
                {course.description}
              </p>
            )}

            <CoursePlayer client:load course={course} slug={slug!} />

            <div class="flex items-center justify-between pt-6 hairline-t">
              <a href="/cursos" class="link-arrow text-sm">
                <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                Volver a cursos
              </a>
            </div>
          </div>
        </article>
      </main>
      <Footer />
    </LayoutBase>
  )
}

<style>
  .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 90%, transparent);
  }
  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 2.5rem 0 0.75rem;
    color: var(--color-text);
  }
  .post-body :global(h2) { font-size: 1.75rem; }
  .post-body :global(h3) { font-size: 1.35rem; }
  .post-body :global(p) { margin: 0 0 1rem; }
  .post-body :global(ul),
  .post-body :global(ol) { margin: 0 0 1rem; padding-left: 1.25rem; }
  .post-body :global(ul) { list-style: square; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(li) { margin-bottom: 0.4rem; }
  .post-body :global(strong) { color: var(--color-text); }
  .post-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 1rem;
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1rem 0.35rem;
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    overflow-wrap: anywhere;
  }
  .post-body :global(pre code) {
    padding: 0;
    background: transparent;
    border: none;
  }
  .post-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 30rem;
    aspect-ratio: 9 / 16;
    object-fit: contain;
    margin: 1.5rem auto;
    border: 1px solid var(--hairline);
    border-radius: 2px;
  }
</style>
