---
import LayoutBase from "../layouts/LayoutBase.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import ProjectRow from "../components/shared/ProjectRow.astro";
import type { Project } from "../types/Project";
import { featuredProjects } from "../data/projects";

const apiBaseUrl = process.env.API_BASE_URL ?? import.meta.env.API_BASE_URL;
let apiProjects: Project[] = [];
try {
  const response = await fetch(`${apiBaseUrl}/projects/public`, {
    signal: AbortSignal.timeout(5000),
  });
  if (response.ok) apiProjects = (await response.json()).projects ?? [];
} catch (error) {
  console.error("No se pudo cargar projects:", error);
}
// Respaldo: si el backend falla o no tiene proyectos, se muestran los destacados.
const projects: Project[] = apiProjects.length > 0 ? apiProjects : featuredProjects;
---

<LayoutBase title="Proyectos | Aron Choque">
  <Header />
  <main id="main" class="flex-1">
    <section class="py-16 lg:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <h1 class="display text-[clamp(2.5rem,6vw,4.5rem)] text-left mb-8 text-[var(--color-text)]">
          Proyectos
        </h1>
        <ul class="hairline-t">
          {projects.map((project, i) => <ProjectRow project={project} eager={i < 3} />)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</LayoutBase>

